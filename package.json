{
  "name": "@hollower233/roblox-cloud-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Roblox Cloud CLI and SDK for credentials and a verified local universe catalog",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "rbx": "dist/cli/main.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:live:localization": "tsx scripts/localization-smoke.ts",
    "test:live:cloud": "tsx scripts/cloud-management-smoke.ts",
    "test:live:places": "tsx scripts/places-smoke.ts",
    "test:live:icons": "tsx scripts/icon-tasks-smoke.ts",
    "dev": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@inquirer/password": "5.2.2",
    "commander": "15.0.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
